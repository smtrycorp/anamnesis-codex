#!/usr/bin/env python3
"""anamnesis-mcp-proxy: stdio MCP bridge for Codex.

Codex spawns this per session (see .mcp.json). Each newline-delimited
JSON-RPC message on stdin is forwarded to {server_url}/mcp with the
credentials in ~/.anamnesis/config.json, and the reply goes to stdout.

The capture hooks rotate the OAuth refresh token too, and the server rejects
a rotated-out one. So the proxy re-reads config.json for every request,
refreshes only under the same refresh.lck lock the hooks use (a symlink
naming the holder's PID, removed only under its guard link), and re-reads
config.json after taking it. A
refresh that still fails is reported on stderr and returned as the tool
error.

Capture off (`anamnesis pause`, or ANAMNESIS_CAPTURE set to off/0/false/no,
any case; an unrecognised value counts as off) is checked per message: the
proxy then answers the protocol itself, lists no tools and never connects,
because a memory lookup carries the conversation with it.

Requires only the Python 3 standard library.
"""

from __future__ import annotations

import json
import os
import ssl
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

HOME = os.environ.get("ANAMNESIS_HOME", os.path.expanduser("~/.anamnesis"))
CONFIG_PATH = os.path.join(HOME, "config.json")
PAUSE_PATH = os.path.join(HOME, "paused")
REFRESH_LOCK = os.path.join(HOME, "refresh.lck")
DEFAULT_SERVER = "https://anamnesis.smtry.ai"
REFRESH_MARGIN_S = 60  # same threshold as the hooks
REFRESH_LOCK_WAIT_S = 10
TIMEOUT_S = 20
MAX_RESPONSE_BYTES = 16 * 1024 * 1024
# A token response or an error body is a few hundred bytes; anything near
# this is not one.
MAX_SMALL_BODY_BYTES = 64 * 1024
PLUGIN_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))


def _client_tag() -> str:
    """"codex-proxy/<version>" for the X-Anamnesis-Client header on every
    request, so the server can say which client and version a user runs. The
    version comes from the plugin manifest, where it is written once."""
    try:
        with open(os.path.join(PLUGIN_ROOT, ".codex-plugin", "plugin.json")) as f:
            version = json.load(f).get("version")
    except (OSError, ValueError, AttributeError):
        version = None
    return f"codex-proxy/{version if isinstance(version, str) and version else '0'}"


CLIENT_TAG = _client_tag()


class ProxyError(Exception):
    """A failure to report to Codex as a JSON-RPC error and on stderr."""


def _ssl_context() -> ssl.SSLContext:
    """Default context, with CA-bundle fallbacks for interpreters that load no
    system CAs (python.org macOS builds without Install Certificates.command)."""
    ctx = ssl.create_default_context()
    if ctx.cert_store_stats().get("x509_ca"):
        return ctx
    try:
        import certifi  # type: ignore[import-not-found]

        return ssl.create_default_context(cafile=certifi.where())
    except (ImportError, OSError, ssl.SSLError):
        pass
    for cafile in (
        "/etc/ssl/cert.pem",
        "/opt/homebrew/etc/ca-certificates/cert.pem",
        "/usr/local/etc/ca-certificates/cert.pem",
        "/etc/ssl/certs/ca-certificates.crt",
        "/etc/pki/tls/certs/ca-bundle.crt",
    ):
        if os.path.exists(cafile):
            try:
                return ssl.create_default_context(cafile=cafile)
            except (OSError, ssl.SSLError):
                continue
    return ctx  # no bundle found: verification fails loudly, not silently


_SSL_CTX = _ssl_context()


class _SameOriginRedirects(urllib.request.HTTPRedirectHandler):
    """urllib re-sends the Authorization header to wherever a redirect
    points, so only a redirect that stays on the configured origin (same
    scheme, host and port, hence no https to http downgrade) is followed."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        old, new = urllib.parse.urlsplit(req.full_url), urllib.parse.urlsplit(newurl)
        if (new.scheme, new.netloc) != (old.scheme, old.netloc):
            raise ProxyError(
                f"the server redirected to another origin ({new.scheme}://{new.netloc}); not followed with credentials"
            )
        return super().redirect_request(req, fp, code, msg, headers, newurl)


_OPENER = urllib.request.build_opener(urllib.request.HTTPSHandler(context=_SSL_CTX), _SameOriginRedirects())


def _read_bounded(resp, limit: int, what: str) -> bytes:
    raw = resp.read(limit + 1)
    if len(raw) > limit:
        raise ProxyError(f"{what} larger than {limit} bytes")
    return raw


def _log(msg: str) -> None:
    print(f"anamnesis-mcp-proxy: {msg}", file=sys.stderr, flush=True)


def capture_enabled() -> bool:
    if os.path.exists(PAUSE_PATH):
        return False
    value = os.environ.get("ANAMNESIS_CAPTURE", "on").strip().lower() or "on"
    if value in ("on", "1", "true", "yes"):
        return True
    if value not in ("off", "0", "false", "no"):
        _log(f"ANAMNESIS_CAPTURE={value} is not recognised; treating it as off")
    return False


def _load_config() -> dict:
    try:
        with open(CONFIG_PATH, encoding="utf-8") as f:
            cfg = json.load(f)
    except (OSError, ValueError) as exc:
        raise ProxyError(f"cannot read {CONFIG_PATH} ({exc}); run anamnesis-config") from exc
    if not isinstance(cfg, dict) or not (
        (cfg.get("access_token") and cfg.get("refresh_token")) or cfg.get("api_key")
    ):
        raise ProxyError(f"{CONFIG_PATH} holds no credentials; run anamnesis-config")
    return cfg


def _save_config(cfg: dict) -> None:
    # mkstemp creates the file 0600, so the new token pair is never readable
    # by anyone else, even before the rename.
    fd, tmp = tempfile.mkstemp(dir=HOME, prefix="config.json.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(cfg, f, indent=2)
        os.replace(tmp, CONFIG_PATH)
    except OSError:
        os.unlink(tmp)
        raise


def _pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def _lock(path: str, wait_s: float) -> bool:
    """Takes the hooks' symlink lock (target: the holder's PID) by the hooks'
    rules: a dead holder's lock is reclaimed, a live holder's is waited for."""
    me = str(os.getpid())
    deadline = time.monotonic() + wait_s
    while True:
        try:
            os.symlink(me, path)
            return True
        except FileExistsError:
            pass
        # A reclaim that succeeded removed a dead holder's link, so retrying
        # at once cannot loop unless a holder dies every time.
        if _reclaim(path):
            continue
        if time.monotonic() > deadline:
            return False
        time.sleep(0.1)


def _holder(path: str) -> str:
    try:
        return os.readlink(path)
    except OSError:
        return ""


def _reclaim(path: str) -> bool:
    """Removes the lock when its holder is dead (or is not a PID at all);
    True only when it removed the link. Removal, here and in _unlock, runs
    under the lock's guard link and reads the holder after taking it, so a
    link that a live process took between the check and the removal is
    never removed; renaming aside and checking afterwards could be."""
    if not _guard_take(path):
        return False
    try:
        holder = _holder(path)
        if not holder or (holder.isdigit() and _pid_alive(int(holder))):
            return False
        os.unlink(path)
        return True
    except OSError:
        return False
    finally:
        _guard_release(path)


def _guard_take(path: str) -> bool:
    """The guard is held for a few milliseconds; one whose holder is dead
    was left by a process killed in that window and is removed."""
    me = str(os.getpid())
    for _ in range(10):
        try:
            os.symlink(me, f"{path}.guard")
            return True
        except FileExistsError:
            pass
        holder = _holder(f"{path}.guard")
        if holder.isdigit() and not _pid_alive(int(holder)):
            try:
                os.unlink(f"{path}.guard")
            except OSError:
                pass
        time.sleep(0.1)
    return False


def _guard_release(path: str) -> None:
    if _holder(f"{path}.guard") == str(os.getpid()):
        try:
            os.unlink(f"{path}.guard")
        except OSError:
            pass


def _unlock(path: str) -> None:
    if not _guard_take(path):
        _log(f"{path}.guard is stuck; releasing without it")
    if _holder(path) == str(os.getpid()):
        try:
            os.unlink(path)
        except OSError:
            pass
    _guard_release(path)


def _fresh(cfg: dict) -> bool:
    try:
        return float(cfg.get("expires_at", 0)) > time.time() + REFRESH_MARGIN_S
    except (TypeError, ValueError):
        return False


def _refresh(stale_access: str) -> dict:
    """Returns a config with a usable access token in place of stale_access:
    one another process already rotated in, or a new pair from the server."""
    if not _lock(REFRESH_LOCK, REFRESH_LOCK_WAIT_S):
        raise ProxyError("token refresh skipped: another process holds refresh.lck")
    try:
        cfg = _load_config()
        if cfg.get("access_token") != stale_access and _fresh(cfg):
            return cfg
        server = cfg.get("server_url", DEFAULT_SERVER).rstrip("/")
        body = urllib.parse.urlencode(
            {
                "grant_type": "refresh_token",
                "refresh_token": cfg["refresh_token"],
                "client_id": cfg.get("client_id", ""),
            }
        ).encode()
        req = urllib.request.Request(
            f"{server}/oauth/token",
            data=body,
            headers={"Content-Type": "application/x-www-form-urlencoded", "X-Anamnesis-Client": CLIENT_TAG},
        )
        try:
            with _OPENER.open(req, timeout=TIMEOUT_S) as resp:
                tok = json.loads(_read_bounded(resp, MAX_SMALL_BODY_BYTES, "token response"))
        except urllib.error.HTTPError as exc:
            try:
                err = json.loads(exc.read(MAX_SMALL_BODY_BYTES))
                detail = ": ".join(str(err[k]) for k in ("error", "error_description") if err.get(k))
            except (ValueError, AttributeError):
                detail = ""
            raise ProxyError(
                f"token refresh failed (HTTP {exc.code} {detail}); run anamnesis-config to sign in again"
            ) from exc
        except (urllib.error.URLError, OSError, ValueError) as exc:
            raise ProxyError(f"token refresh failed ({exc})") from exc
        if not isinstance(tok, dict) or not isinstance(tok.get("access_token"), str) or not tok["access_token"]:
            raise ProxyError("token refresh returned no access_token; run anamnesis-config")
        cfg["access_token"] = tok["access_token"]
        # A response without refresh_token keeps the current one (RFC 6749 §6).
        cfg["refresh_token"] = tok.get("refresh_token") or cfg["refresh_token"]
        cfg["expires_at"] = int(time.time()) + int(tok.get("expires_in", 3600))
        try:
            _save_config(cfg)
        except OSError as exc:
            # The server has already retired the old refresh token.
            raise ProxyError(f"could not save the new tokens ({exc}); run anamnesis-config") from exc
        return cfg
    finally:
        _unlock(REFRESH_LOCK)


def _send(cfg: dict, message: dict) -> tuple[int, bytes]:
    server = cfg.get("server_url", DEFAULT_SERVER).rstrip("/")
    if cfg.get("access_token") and cfg.get("refresh_token"):
        auth = {"Authorization": f"Bearer {cfg['access_token']}"}
    else:
        auth = {"X-Anamnesis-Key": cfg["api_key"]}
    req = urllib.request.Request(
        f"{server}/mcp",
        data=json.dumps(message).encode(),
        headers={"Content-Type": "application/json", "X-Anamnesis-Client": CLIENT_TAG, **auth},
    )
    try:
        with _OPENER.open(req, timeout=TIMEOUT_S) as resp:
            return 200, _read_bounded(resp, MAX_RESPONSE_BYTES, "server response")
    except urllib.error.HTTPError as exc:
        return exc.code, b""


def forward(message: dict) -> dict | None:
    """Forwards one JSON-RPC message; returns the reply, or None for an
    accepted notification. A 401 gets one retry through a refresh."""
    cfg = _load_config()
    oauth = bool(cfg.get("access_token") and cfg.get("refresh_token"))
    if oauth and not _fresh(cfg):
        cfg = _refresh(cfg["access_token"])
    status, raw = _send(cfg, message)
    if status == 401 and oauth:
        cfg = _refresh(cfg["access_token"])
        status, raw = _send(cfg, message)
    if status in (401, 403):
        raise ProxyError(f"server rejected the sign-in (HTTP {status}); run anamnesis-config")
    if status >= 300:
        raise ProxyError(f"server answered HTTP {status}")
    return json.loads(raw) if raw.strip() else None


def invalid_request(message) -> dict | None:
    """The -32600 reply for a line that is not a JSON-RPC request object, or
    None when the shape is fine. The id goes back when it is usable."""
    msg_id = message.get("id") if isinstance(message, dict) else None
    if not isinstance(msg_id, (str, int)) or isinstance(msg_id, bool):
        msg_id = None
    params = message.get("params", {}) if isinstance(message, dict) else None
    if (
        isinstance(message, dict)
        and isinstance(message.get("method"), str)
        and isinstance(params, (dict, list))
        and ("id" not in message or msg_id is not None or message["id"] is None)
    ):
        return None
    return {"jsonrpc": "2.0", "id": msg_id,
            "error": {"code": -32600, "message": "expected one JSON-RPC request object per line"}}


def offline_reply(message: dict) -> dict:
    method = message.get("method")
    params = message.get("params")
    if method == "initialize":
        return {"jsonrpc": "2.0", "id": message["id"], "result": {
            "protocolVersion": (params if isinstance(params, dict) else {}).get("protocolVersion", "2025-06-18"),
            "capabilities": {"tools": {}},
            "serverInfo": {"name": "anamnesis (off for this session)", "version": "0"}}}
    if method in ("tools/list", "prompts/list", "resources/list"):
        return {"jsonrpc": "2.0", "id": message["id"], "result": {method.split("/")[0]: []}}
    if method == "ping":
        return {"jsonrpc": "2.0", "id": message["id"], "result": {}}
    return {"jsonrpc": "2.0", "id": message.get("id"), "error": {
        "code": -32000,
        "message": "Anamnesis is off for this session (paused, or ANAMNESIS_CAPTURE is off)"}}


def _reply(response: dict) -> None:
    sys.stdout.write(json.dumps(response) + "\n")
    sys.stdout.flush()


def main() -> int:
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            message = json.loads(line)
        except ValueError:
            _log("ignored a line that is not JSON")
            continue
        bad = invalid_request(message)
        if bad is not None:
            _reply(bad)
            continue
        is_notification = "id" not in message
        if not capture_enabled():
            response = None if is_notification else offline_reply(message)
        else:
            try:
                response = forward(message)
            except (ProxyError, urllib.error.URLError, OSError, ValueError) as exc:
                _log(str(exc))
                response = None if is_notification else {
                    "jsonrpc": "2.0", "id": message.get("id"),
                    "error": {"code": -32000, "message": f"anamnesis proxy: {exc}"}}
        if response is not None and not is_notification:
            _reply(response)
    return 0


if __name__ == "__main__":
    sys.exit(main())
